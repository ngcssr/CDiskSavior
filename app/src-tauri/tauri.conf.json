{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CDisk Savior",
  "version": "0.1.0",
  "identifier": "com.cdisksavior.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:svc",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CDisk Savior",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/cdisk-savior-svc"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
